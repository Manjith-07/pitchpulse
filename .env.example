POSTGRES_USER=pitchpulse
POSTGRES_PASSWORD=pitchpulse
POSTGRES_DB=pitchpulse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AIRFLOW_DB=airflow
# Must match your host user's UID (run `id -u`) so the Airflow container can
# write to bind-mounted folders like dbt/ and data/. 1000 is the default for
# the first user on most Linux/WSL distros.
AIRFLOW_UID=1000

REDIS_HOST=redis
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=live-match-events

LIVE_CRICKET_API_KEY=your_key_here
LIVE_CRICKET_API_BASE_URL=https://api.cricapi.com/v1
